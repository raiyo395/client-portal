# Browser-safe Supabase project settings used by the Vite app.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional one-click demo access shown on the login page.
VITE_DEMO_ADMIN_EMAIL=demo-admin@example.com
VITE_DEMO_CLIENT_EMAIL=demo-client@example.com
VITE_DEMO_PASSWORD=replace-with-a-demo-only-password

# Server-side demo script settings. Keep these out of VITE_ variables and
# never expose the service-role key to the browser or commit real values.
DEMO_SUPABASE_URL=https://your-demo-project-id.supabase.co
DEMO_SERVICE_ROLE_KEY=your-demo-service-role-key
DEMO_ADMIN_EMAIL=demo-admin@example.com
DEMO_CLIENT_EMAIL=demo-client@example.com
DEMO_PASSWORD=replace-with-a-demo-only-password
